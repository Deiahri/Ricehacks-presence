# Copy to .env for local runs: node --env-file=.env server.mjs
# On Render, set these in the Web Service's Environment settings instead (.env is git-ignored).

# Port to listen on. Render sets this itself; leave it unset there.
PORT=8787

# Postgres connection string for accounts, friends, BP and workouts (Tiger Cloud: Service → Connect).
# Paste Tiger's string as-is: sslmode=require means encrypted but not certificate-checked, as in psql (see db.mjs).
# Leave unset to run without storage: sets are then logged as "skipped" and /api/* answers 503.
DATABASE_URL=postgres://tsdbadmin:your-password@your-service.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# Voice coach (ElevenLabs Agents). The key stays on the server; the app only ever gets a one-session token.
# Create the agent once with `npm run coach:agent` and paste the id it prints. Leave unset to run without a coach.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Comma-separated origins allowed to call /api/* from a browser. Default: * (auth is a header, not a cookie).
ALLOWED_ORIGINS=
