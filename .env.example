# Copy to .env for local runs: node --env-file=.env server.mjs
# On Render, set these in the Web Service's Environment settings instead (.env is git-ignored).

# Port to listen on. Render sets this itself; leave it unset there.
PORT=8787

# Postgres connection string for workout storage (Tiger Cloud: Service → Connect).
# Paste Tiger's string as-is: sslmode=require means encrypted but not certificate-checked, as in psql (see db.mjs).
# Leave unset to run without storage; finished sets are then logged as "skipped".
DATABASE_URL=postgres://tsdbadmin:your-password@your-service.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
